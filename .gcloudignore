# Explicit Cloud Build source bundle for the agent service.
.gcloudignore
.git/
.gitignore
.agents/
.claude/
.codex/
.python-version
.playwright-mcp/
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/.venv/
**/.pytest_cache/
**/node_modules/
**/.next/
**/*.log
docs/
web/
agent/data/
data/outbox/

# Only tracked runtime references cross the Cloud Build boundary: the
# public-domain airport dataset and Waterline's synthetic condition-card asset.
# Local NAV CANADA captures remain excluded: their source terms do not grant a
# clear right to bundle copied payloads in a deployed application.
data/*
!data/reference/
!data/reference/**
